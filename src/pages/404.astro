---
import NotFoundPage from '@components/content/NotFoundPage.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page Not Found | FRCDesign.org</title>
    <meta name="description" content="The page you were looking for could not be found." />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main>
      <NotFoundPage />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --sl-color-white: #fff;
    --sl-color-gray-1: #e8e9ee;
    --sl-color-gray-2: #c5c8d2;
    --sl-color-gray-3: #a0a4b4;
    --sl-color-gray-4: #5d6374;
    --sl-color-gray-5: #383d4a;
    --sl-color-gray-6: #242833;
    --sl-color-gray-7: #171a22;
    --sl-color-black: #080b11;
    --sl-text-sm: 0.875rem;
    --sl-text-lg: 1.125rem;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--sl-color-black);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  body {
    min-height: 100vh;
    margin: 0;
    color: var(--sl-color-gray-1);
    background: var(--sl-color-black);
  }

  main {
    width: min(100%, 76rem);
    min-height: 100vh;
    display: grid;
    align-items: center;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem);
  }
</style>
