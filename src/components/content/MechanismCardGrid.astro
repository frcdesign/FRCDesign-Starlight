---
import { Image } from 'astro:assets';
import { glossaryTerms } from '../../data/glossary';

interface MechanismCard {
  title: string;
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  description: string;
}

interface Props {
  cards: MechanismCard[];
}

const { cards } = Astro.props;

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

const renderGlossaryDescription = (description: string) => {
  let html = escapeHtml(description);

  for (const entry of [...glossaryTerms].sort((a, b) => b.term.length - a.term.length)) {
    const pattern = new RegExp(`(^|[^\\w-])(${escapeRegExp(entry.term)})(?=$|[^\\w-])`, 'gi');
    html = html.replace(
      pattern,
      `$1<span class="glossary-term" data-tooltip="${escapeHtml(entry.definition)}">$2</span>`
    );
  }

  return html;
};
---

<div class="mechanism-card-grid">
  {cards.map((card) => (
    <a href={card.href} class="mechanism-card" aria-label={`Open ${card.title}`}>
      <span class="mechanism-card-media">
        <Image src={card.image} alt={card.imageAlt} loading="lazy" data-no-lightbox />
      </span>
      <span class="mechanism-card-body">
        <span class="mechanism-card-title">{card.title}</span>
        <span class="mechanism-card-description" set:html={renderGlossaryDescription(card.description)} />
      </span>
    </a>
  ))}
</div>

<style>
  .mechanism-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    align-items: stretch;
    gap: 1rem;
    margin-block: 1rem 2rem;
  }

  .mechanism-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    margin: 0 !important;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-black);
    color: inherit;
    text-decoration: none;
  }

  .mechanism-card:hover {
    border-color: #2fbf5b;
  }

  .mechanism-card-media {
    overflow: hidden;
    height: clamp(14rem, 24vw, 20rem);
    padding: clamp(0.75rem, 2vw, 1.25rem);
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
    box-sizing: border-box;
  }

  .mechanism-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    transition: transform 160ms ease;
  }

  .mechanism-card:hover img {
    transform: scale(1.02);
  }

  .mechanism-card-body {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
  }

  .mechanism-card-title {
    display: block;
    margin: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-xl);
    font-weight: 700;
    line-height: var(--sl-line-height-headings);
  }

  .mechanism-card-description {
    display: block;
    margin: 0;
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }

  .mechanism-card-body :global(.glossary-term) {
    position: relative;
    cursor: help;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--sl-color-gray-4);
    text-underline-offset: 0.2em;
  }

  .mechanism-card-body :global(.glossary-term)::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    z-index: 20;
    width: max-content;
    max-width: 18rem;
    margin-bottom: 0.5rem;
    padding: 0.5rem 0.75rem;
    transform: translateX(-50%);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    opacity: 0;
    pointer-events: none;
    text-align: center;
    visibility: hidden;
  }

  .mechanism-card-body :global(.glossary-term):hover::after {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 44rem) {
    .mechanism-card-grid {
      grid-template-columns: 1fr;
    }

    .mechanism-card-media {
      height: clamp(12rem, 58vw, 20rem);
    }
  }
</style>
